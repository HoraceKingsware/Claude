# 京东账号配置
JD_USERNAME=your_jd_username
JD_PASSWORD=your_jd_password

# 浏览器配置
HEADLESS=False
BROWSER_TYPE=chrome
# USER_DATA_DIR=/path/to/user/data/dir

# AI大模型配置（用于验证码识别）
# 支持的提供商: anthropic, openai
AI_PROVIDER=anthropic
AI_API_KEY=your_api_key_here
AI_MODEL=claude-3-5-sonnet-20241022
# AI_API_BASE=https://api.anthropic.com  # 可选，自定义API端点

# 如果使用OpenAI
# AI_PROVIDER=openai
# AI_API_KEY=your_openai_api_key
# AI_MODEL=gpt-4-vision-preview
# AI_API_BASE=https://api.openai.com/v1

# 反爬虫配置
ENABLE_STEALTH=True
RANDOM_DELAY_MIN=1.0
RANDOM_DELAY_MAX=3.0

# 重试配置
MAX_RETRY_TIMES=3
RETRY_DELAY=2.0

# 超时配置（秒）
PAGE_LOAD_TIMEOUT=30
ELEMENT_WAIT_TIMEOUT=10

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=jd_login.log
